<Window x:Class="Tether.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Tether.UI"
        Title="Tether" Width="360" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBg}" FontFamily="{StaticResource UiFont}"
        BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ui:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <ui:InverseBoolConverter x:Key="InvBool" />
        <ui:ZeroToVisibleConverter x:Key="ZeroToVis" />
        <ui:NullableIntConverter x:Key="NullInt" />
        <ui:CanUseAsOutputConverter x:Key="CanUseOutput" />

        <Style x:Key="DeviceIconBg" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Battery" TargetType="ProgressBar" BasedOn="{StaticResource BatteryBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputRow" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Tether.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Tether" Style="{StaticResource Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleRadioCommand}"
                        Visibility="{Binding Bluetooth.IsRadioAvailable, Converter={StaticResource BoolToVis}}"
                        ToolTip="Turn Bluetooth on or off">
                    <TextBlock Text="&#xE702;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bluetooth.IsRadioOn}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Refresh_Click" ToolTip="Refresh battery levels">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Update banner -->
        <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,4,0,4"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <ProgressBar Style="{StaticResource BatteryBar}" Foreground="{DynamicResource Accent}" Maximum="1" Margin="0,6,90,0"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Padding="12,5" Content="Install"
                        Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InvBool}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource SectionHeader}" Margin="4,8,4,6" />

                <!-- Radio off -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,6"
                        Visibility="{Binding Bluetooth.IsRadioOn, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Bluetooth is off" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Turn it on to see your devices." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Padding="12,5"
                                Content="Turn on" Command="{Binding ToggleRadioCommand}" />
                    </Grid>
                </Border>

                <TextBlock Text="Looking for devices…" Style="{StaticResource Caption}" Margin="4,0,4,8"
                           Visibility="{Binding Bluetooth.IsLoading, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding VisibleDevices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding ActionText}" Click="Menu_Toggle_Click" />
                                        <MenuItem Header="Use as audio output" Click="Menu_UseOutput_Click"
                                                  Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" />
                                        <Separator />
                                        <MenuItem Header="Profile and name…" Click="Menu_Profile_Click" />
                                        <MenuItem Header="Hide from Tether" Click="Menu_Hide_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource DeviceIconBg}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource DeviceGlyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}" FontWeight="SemiBold" MaxWidth="150" />
                                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0"
                                                       Foreground="{DynamicResource TextSecondary}" ToolTip="Has a profile"
                                                       Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource Battery}" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left"
                                                     Value="{Binding Battery, Converter={StaticResource NullInt}, Mode=OneWay}"
                                                     Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6" Margin="0,0,4,0"
                                            ToolTip="Use as audio output"
                                            Command="{Binding DataContext.UseAsOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource CanUseOutput}">
                                                <Binding Path="IsConnected" />
                                                <Binding Path="IsAudio" />
                                                <Binding Path="IsDefaultOutput" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="14" />
                                    </Button>

                                    <Button Grid.Column="3" Style="{StaticResource ConnectButton}" Content="{Binding ActionText}"
                                            Command="{Binding DataContext.ToggleConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border Style="{StaticResource Card}">
                    <Border.Visibility>
                        <Binding Path="Bluetooth.Devices.Count" Converter="{StaticResource ZeroToVis}" />
                    </Border.Visibility>
                    <StackPanel HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock Text="&#xE702;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="No paired devices yet" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock Text="Pair once in Windows Settings, then Tether takes over." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Pair a device" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Command="{Binding OpenBluetoothSettingsCommand}" />
                    </StackPanel>
                </Border>

                <!-- Audio output -->
                <StackPanel Visibility="{Binding ShowAudioSection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Audio output" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}" Padding="4">
                        <ItemsControl ItemsSource="{Binding Outputs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OutputRow}"
                                            Command="{Binding DataContext.SetOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13"
                                                       Foreground="{DynamicResource Accent}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,4"
                    Command="{Binding OpenBluetoothSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="Bluetooth settings" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
        </Grid>
    </Grid>
</Window>
